# Frontend Environment Variables
NEXTAUTH_SECRET=LlKq6ZtYbr+hTC073mAmAh9/h2HwMfsFo4hrfCx5mLg=
NEXTAUTH_URL=http://localhost:8080/
NEXT_APP_API_URL=http://localhost:8080
NEXT_APP_JWT_SECRET=YOUR_NEXT_APP_JWT_SECRET_HERE
NEXT_APP_JWT_TIMEOUT=86400
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_APP_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Business Central Credentials (Backend)
BC_CLIENT_ID=YOUR_BC_CLIENT_ID_HERE
BC_CLIENT_SECRET=YOUR_BC_CLIENT_SECRET_HERE
BC_TENANT_ID=YOUR_BC_TENANT_ID_HERE
BC_BASE_URL=YOUR_BC_BASE_URL_HERE
BC_TOKEN_URI=YOUR_BC_TOKEN_URI_HERE

# Backend JWT signing key. REQUIRED — the backend refuses to start without it.
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
# Never reuse NEXT_APP_JWT_SECRET here, and never commit the real value.
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Browser origins allowed to call the backend, comma-separated.
# Prod: https://plexus-tec.com,https://www.plexus-tec.com
ALLOWED_ORIGINS=http://localhost:3000

# Partner API (commercial mobile app backend -> Plexus), sent as the X-API-Key header.
# Leave empty to keep /api/partner/** closed. Generate with: openssl rand -base64 32
PARTNER_API_KEY=

# PLEXUSPEC customer the demandes de devis are booked against.
DEMANDE_DEVIS_CUSTOMER_NO=C0090
